# Copy to app/.streamlit/secrets.toml for local dev (gitignored), or paste
# into Streamlit Community Cloud's Secrets UI for the deployed app.
# Everything here is optional — with none of it set, the app runs exactly
# as it does today: anonymous, unauthenticated, no persistence.

# Hosted Postgres connection string (e.g. from Supabase: Settings > Database).
# Without this, assessments simply aren't recorded — the assessment UX is
# unaffected either way.
DATABASE_URL = "postgresql://user:password@host:5432/postgres"

# Turns on the Clinician Worklist tab. Leave false/absent to keep the
# deployed app exactly as-is.
[features]
clinician_worklist = false

# Clinician login for the worklist tab. Generate a password hash with
# scripts/hash_password.py — never store a plaintext password here.
[credentials]
[credentials.usernames]
[credentials.usernames.clinician]
name = "Clinician"
password = "$2b$12$replace-with-a-real-bcrypt-hash"

[cookie]
name = "diabetes_risk_platform_auth"
key = "replace-with-a-random-signing-key"
expiry_days = 30
